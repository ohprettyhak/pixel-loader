{
  "name": "@pixel-loader/svelte",
  "version": "0.0.1",
  "type": "module",
  "description": "Svelte wrapper for PixelLoader web component",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "svelte": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./PixelLoader.svelte": {
      "svelte": "./dist/PixelLoader.svelte",
      "default": "./dist/PixelLoader.svelte"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && mkdir -p dist && cp src/PixelLoader.svelte dist/PixelLoader.svelte && cp src/index.d.ts dist/index.d.ts && node -e \"const fs = require('fs'); fs.writeFileSync('dist/index.js', \\\"import '@pixel-loader/core';\\\\nexport { default as PixelLoader } from './PixelLoader.svelte';\\\\n\\\");\"",
    "dev": "pnpm build",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "biome check ./src",
    "format": "biome format --write ./src",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "svelte",
    "web-components",
    "lit",
    "loading-indicator",
    "loader",
    "animation"
  ],
  "peerDependencies": {
    "svelte": "^3.0.0 || ^4.0.0 || ^5.0.0"
  },
  "dependencies": {
    "@pixel-loader/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.19.30",
    "svelte": "^4.2.20",
    "svelte-check": "^3.8.6",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
