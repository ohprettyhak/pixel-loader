{
  "name": "@pixel-loader/vue",
  "version": "0.1.0",
  "type": "module",
  "description": "Vue wrapper for PixelLoader web component",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bunchee",
    "dev": "bunchee --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check ./src",
    "format": "biome format --write ./src",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "vue",
    "web-components",
    "lit",
    "loading-indicator",
    "loader",
    "animation"
  ],
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "dependencies": {
    "@pixel-loader/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.19.30",
    "typescript": "^5.9.3",
    "vue": "^3.5.27",
    "vue-tsc": "^1.8.27"
  },
  "publishConfig": {
    "access": "public"
  }
}
