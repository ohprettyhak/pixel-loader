{
  "name": "@pixel-loader/react",
  "version": "0.1.0",
  "type": "module",
  "description": "React wrapper for PixelLoader web component",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check ./src",
    "format": "biome format --write ./src",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "react",
    "web-components",
    "lit",
    "loading-indicator",
    "loader",
    "animation"
  ],
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0 || ^20.0.0"
  },
  "dependencies": {
    "@lit/react": "^1.0.8",
    "@pixel-loader/core": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
