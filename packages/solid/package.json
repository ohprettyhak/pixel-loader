{
  "name": "@pixel-loader/solid",
  "version": "0.0.3",
  "type": "module",
  "description": "Solid integration for PixelLoader web component",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check ./src",
    "format": "biome format --write ./src",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "solid-js",
    "web-components",
    "lit",
    "loading-indicator",
    "loader",
    "animation"
  ],
  "peerDependencies": {
    "solid-js": "^1.8.0"
  },
  "dependencies": {
    "@pixel-loader/core": "workspace:*"
  },
  "devDependencies": {
    "solid-js": "^1.9.11",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
