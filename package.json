{
  "name": "pixel-loader",
  "version": "0.1.0",
  "private": true,
  "description": "A 3x3 cell loading indicator web component library with framework integrations",
  "workspaces": [
    "packages/*",
    "examples"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "release": "turbo run build --filter=!examples && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.13",
    "@changesets/cli": "^2.29.8",
    "@types/node": "^20.19.30",
    "tsup": "^8.5.1",
    "turbo": "^2.8.1",
    "typescript": "^5.9.3",
    "ultracite": "7.1.1"
  },
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=18.0.0"
  }
}
