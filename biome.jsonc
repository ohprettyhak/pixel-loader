{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/next"
  ],
  "overrides": [
    {
      "includes": ["examples/**/*"],
      "linter": {
        "rules": {
          "suspicious": {
            "noReactSpecificProps": "off"
          },
          "correctness": {
            "noUnusedVariables": "warn"
          },
          "a11y": {
            "useButtonType": "off"
          },
          "performance": {
            "useSolidForComponent": "off"
          }
        }
      }
    }
  ]
}
